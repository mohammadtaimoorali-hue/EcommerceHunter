# Backend (backend/.env should mirror this file for local dev)
DATABASE_URL="file:./dev.db"
PORT=4000

# eBay Sell API (leave blank for dry-run/mock-only operation; see README for sandbox setup)
EBAY_ENVIRONMENT=SANDBOX
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=

# Queue worker polling interval (ms)
QUEUE_POLL_INTERVAL_MS=5000

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
