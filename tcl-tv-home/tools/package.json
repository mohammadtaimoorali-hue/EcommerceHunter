{
  "name": "tv-home-tools",
  "private": true,
  "description": "Bundles the Anthropic SDK into a single browser module for the TV home screen.",
  "scripts": {
    "bundle": "esbuild entry.mjs --bundle --format=esm --platform=browser --minify --target=chrome80 --outfile=../web/vendor/anthropic.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
